<Window x:Class="FirebirdAdmin.Presentation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:res="clr-namespace:FirebirdAdmin.Presentation.Wpf.Resources"
        xmlns:shell="clr-namespace:FirebirdAdmin.Presentation.Wpf.Shell"
        xmlns:winshell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding ApplicationName}"
        Icon="pack://application:,,,/FirebirdAdmin.Presentation.Wpf;component/Assets/Branding/FirebirdAdmin.ico"
        Width="1180"
        Height="760"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        MinWidth="820"
        MinHeight="640"
        Background="{DynamicResource Brush.App.Background}"
        Foreground="{DynamicResource Brush.App.Foreground}"
        FontFamily="{DynamicResource FontFamily.Base}"
        StateChanged="Window_OnStateChanged"
        KeyDown="Window_OnKeyDown">
    <winshell:WindowChrome.WindowChrome>
        <winshell:WindowChrome CaptionHeight="34"
                               ResizeBorderThickness="6"
                               GlassFrameThickness="0"
                               CornerRadius="0"
                               UseAeroCaptionButtons="False"/>
    </winshell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="Button.WindowChrome" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.App.Foreground}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="winshell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        </Style>

        <Style x:Key="Button.WindowClose" TargetType="Button" BasedOn="{StaticResource Button.WindowChrome}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Status.Error}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DashboardWorkspaceTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid DataContext="{Binding Dashboard}" Style="{DynamicResource Workspace.Root}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="240"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DataContext.DashboardOperationalTitle, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource Text.EmptyStateTitle}"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Border Style="{DynamicResource Badge.Neutral}" Margin="0,0,8,0"><TextBlock Style="{DynamicResource Text.Badge}" Text="{Binding HealthText}" TextTrimming="CharacterEllipsis"/></Border>
                            <Border Style="{DynamicResource Badge.Neutral}"><TextBlock Style="{DynamicResource Text.Badge}" Text="{Binding LastUpdatedText, StringFormat={x:Static res:AppStrings.LastUpdatedFormat}}" TextTrimming="CharacterEllipsis"/></Border>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding HealthMessage}" Style="{DynamicResource Text.EmptyStateBody}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Metrics}" Margin="0,14,0,14">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource Card.Metric}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{DynamicResource Text.StatusBar}"/>
                                        <TextBlock Text="{Binding Value}" Style="{DynamicResource Text.NavigationItem}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Detail}" Style="{DynamicResource Text.EmptyStateBody}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Grid.Row="2" Style="{DynamicResource Panel.Detail}">
                        <scott:WpfPlot Height="210" Loaded="ActivityPlot_OnLoaded" Unloaded="ActivityPlot_OnUnloaded" AutomationProperties.Name="Gráfico de atividade por snapshot"/>
                    </Border>
                </Grid>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="MonitoringWorkspaceTemplate">
            <Grid DataContext="{Binding TransactionsWorkspace}" Style="{DynamicResource Workspace.Root}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="140"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DataContext.TransactionsTitle, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource Text.EmptyStateTitle}"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Border Style="{DynamicResource Badge.Neutral}" Margin="0,0,8,0"><TextBlock Style="{DynamicResource Text.Badge}" Text="{Binding TransactionCount, StringFormat={x:Static res:AppStrings.TransactionCountFormat}}" TextTrimming="CharacterEllipsis"/></Border>
                        <Border Style="{DynamicResource Badge.Neutral}"><TextBlock Style="{DynamicResource Text.Badge}" Text="{Binding ActiveTransactionCount, StringFormat={x:Static res:AppStrings.ActiveCountFormat}}" TextTrimming="CharacterEllipsis"/></Border>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Message}" Style="{DynamicResource Text.EmptyStateBody}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,16,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DataContext.TransactionsFilterLabel, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource Text.StatusBar}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filtro de transações" TabIndex="10"/>
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Transactions}" SelectedItem="{Binding SelectedTransaction}" AutomationProperties.Name="Lista de transações" TabIndex="11">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnTransaction}" Binding="{Binding TransactionId}" Width="100"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnAttachment}" Binding="{Binding AttachmentId}" Width="100"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnState}" Binding="{Binding State}" Width="80"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnStarted}" Binding="{Binding StartedAt}" Width="160"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnOit}" Binding="{Binding OldestTransaction}" Width="90"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnOat}" Binding="{Binding OldestActive}" Width="90"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnIsolation}" Binding="{Binding IsolationMode}" Width="90"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnLockTimeout}" Binding="{Binding LockTimeout}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="3" Margin="0,12,0,0" Style="{DynamicResource Panel.Detail}">
                    <StackPanel>
                        <TextBlock Text="{Binding DataContext.TransactionDetailsTitle, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource Text.NavigationItem}"/>
                        <TextBlock Text="{Binding SelectedTransaction.TransactionId, StringFormat={x:Static res:AppStrings.IdFormat}}" Style="{DynamicResource Text.EmptyStateBody}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding SelectedTransaction.AttachmentId, StringFormat={x:Static res:AppStrings.AttachmentFormat}}" Style="{DynamicResource Text.EmptyStateBody}"/>
                        <TextBlock Text="{Binding SelectedTransaction.StartedAt, StringFormat={x:Static res:AppStrings.StartedFormat}}" Style="{DynamicResource Text.EmptyStateBody}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ProfilerWorkspaceTemplate">
            <Grid DataContext="{Binding ProfilerWorkspace}" Style="{DynamicResource Workspace.Root}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="190"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:AppStrings.SqlProfiler}" Style="{DynamicResource Text.EmptyStateTitle}"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Border Style="{DynamicResource Badge.Neutral}"><TextBlock Style="{DynamicResource Text.Badge}" Text="{Binding BufferedCount, StringFormat={x:Static res:AppStrings.BufferCountFormat}}" TextTrimming="CharacterEllipsis"/></Border>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Message}" Style="{DynamicResource Text.EmptyStateBody}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </Grid>
                <WrapPanel Grid.Row="1" Style="{DynamicResource Workspace.Toolbar}">
                    <Button Content="{Binding DataContext.StartLabel, RelativeSource={RelativeSource AncestorType=Window}}" Click="StartProfilerButton_OnClick" Style="{DynamicResource Button.Primary}" MinWidth="82" AutomationProperties.Name="Iniciar SQL Profiler" TabIndex="20"/>
                    <Button Content="{Binding DataContext.PauseViewLabel, RelativeSource={RelativeSource AncestorType=Window}}" Click="PauseProfilerButton_OnClick" Style="{DynamicResource Button.Toolbar}" MinWidth="138" AutomationProperties.Name="Pausar visualização do Profiler" TabIndex="21"/>
                    <Button Content="{Binding DataContext.FollowLabel, RelativeSource={RelativeSource AncestorType=Window}}" Click="FollowProfilerButton_OnClick" Style="{DynamicResource Button.Toolbar}" AutomationProperties.Name="Retornar ao modo Follow" TabIndex="22"/>
                    <Button Content="{Binding DataContext.StopLabel, RelativeSource={RelativeSource AncestorType=Window}}" Click="StopProfilerButton_OnClick" Style="{DynamicResource Button.Toolbar}" MinWidth="86" AutomationProperties.Name="Encerrar captura Trace" TabIndex="23"/>
                    <Button Content="{Binding DataContext.ClearLabel, RelativeSource={RelativeSource AncestorType=Window}}" Click="ClearProfilerButton_OnClick" Style="{DynamicResource Button.Toolbar}" AutomationProperties.Name="Limpar visualização do Profiler" TabIndex="24"/>
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TextBox.Toolbar}" MinWidth="260" AutomationProperties.Name="Filtro SQL do Profiler" TabIndex="25"/>
                </WrapPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" AutomationProperties.Name="Eventos do SQL Profiler" TabIndex="26">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnSequence}" Binding="{Binding Sequence}" Width="64"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnTime}" Binding="{Binding Timestamp}" Width="95"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnType}" Binding="{Binding Type}" Width="120"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnDurationMs}" Binding="{Binding Duration}" Width="70"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnUser}" Binding="{Binding UserName}" Width="90"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnAttachmentShort}" Binding="{Binding AttachmentId}" Width="70"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnTransactionShort}" Binding="{Binding TransactionId}" Width="70"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnSqlTrace}" Binding="{Binding SqlPreview}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TabControl Grid.Row="3" Margin="0,8,0,0" TabIndex="27">
                    <TabItem Header="{x:Static res:AppStrings.TabSql}"><TextBox Text="{Binding SelectedSql, Mode=OneWay}" Style="{DynamicResource TextBox.Details}"/></TabItem>
                    <TabItem Header="{x:Static res:AppStrings.TabPerformance}"><TextBox Text="{Binding SelectedPerformance, Mode=OneWay}" Style="{DynamicResource TextBox.Details}"/></TabItem>
                    <TabItem Header="{x:Static res:AppStrings.TabContext}"><TextBox Text="{Binding SelectedContext, Mode=OneWay}" Style="{DynamicResource TextBox.Details}"/></TabItem>
                    <TabItem Header="{x:Static res:AppStrings.TabPlan}"><TextBox Text="{Binding SelectedPlan, Mode=OneWay}" Style="{DynamicResource TextBox.Details}"/></TabItem>
                    <TabItem Header="{x:Static res:AppStrings.TabRawTrace}"><TextBox Text="{Binding SelectedRawTrace, Mode=OneWay}" Style="{DynamicResource TextBox.Details}"/></TabItem>
                </TabControl>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HistoryWorkspaceTemplate">
            <Grid DataContext="{Binding HistoryWorkspace}" Style="{DynamicResource Workspace.Root}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="105"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{x:Static res:AppStrings.History}" Style="{DynamicResource Text.EmptyStateTitle}"/>
                </Grid>
                <WrapPanel Grid.Row="1" Style="{DynamicResource Workspace.Toolbar}">
                    <ComboBox Text="{Binding DataKind, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Style="{DynamicResource ComboBox.Toolbar}" AutomationProperties.Name="Tipo de histórico" TabIndex="30"/>
                    <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TextBox.Toolbar}" AutomationProperties.Name="Filtro de usuário do histórico" TabIndex="31"/>
                    <TextBox Text="{Binding SqlText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TextBox.Toolbar}" MinWidth="260" AutomationProperties.Name="Filtro SQL do histórico" TabIndex="32"/>
                    <Button Content="{Binding DataContext.SearchLabel, RelativeSource={RelativeSource AncestorType=Window}}" Click="SearchHistoryButton_OnClick" Style="{DynamicResource Button.Toolbar}" AutomationProperties.Name="Pesquisar histórico" TabIndex="33"/>
                    <Button Content="{x:Static res:AppStrings.ExportCsv}" Click="ExportHistoryCsvButton_OnClick" Style="{DynamicResource Button.Toolbar}" MinWidth="64" AutomationProperties.Name="Exportar histórico CSV" TabIndex="34"/>
                    <Button Content="{x:Static res:AppStrings.ExportJson}" Click="ExportHistoryJsonButton_OnClick" Style="{DynamicResource Button.Toolbar}" MinWidth="64" AutomationProperties.Name="Exportar histórico JSON" TabIndex="35"/>
                </WrapPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutomationProperties.Name="Resultados do histórico" TabIndex="36">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnId}" Binding="{Binding Id}" Width="56"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnTime}" Binding="{Binding Timestamp}" Width="135"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnSource}" Binding="{Binding Kind}" Width="82"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnType}" Binding="{Binding Type}" Width="110"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnUser}" Binding="{Binding UserName}" Width="90"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnDurationMs}" Binding="{Binding Duration}" Width="70"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnSummary}" Binding="{Binding Summary}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBox Grid.Row="3" Text="{Binding SelectedDetails, Mode=OneWay}" Style="{DynamicResource TextBox.Details}" Margin="0,8,0,0" AutomationProperties.Name="Detalhes do histórico"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AlertsWorkspaceTemplate">
            <Grid DataContext="{Binding AlertsCenter}" Style="{DynamicResource Workspace.Root}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="120"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:AppStrings.Diagnostics}" Style="{DynamicResource Text.EmptyStateTitle}"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Border Style="{DynamicResource Badge.Neutral}" Margin="0,0,8,0"><TextBlock Style="{DynamicResource Text.Badge}" Text="{Binding ActiveCount, StringFormat={x:Static res:AppStrings.ActiveCountFormat}}" TextTrimming="CharacterEllipsis"/></Border>
                        <Border Style="{DynamicResource Badge.Neutral}"><TextBlock Style="{DynamicResource Text.Badge}" Text="{Binding CriticalCount, StringFormat={x:Static res:AppStrings.CriticalCountFormat}}" TextTrimming="CharacterEllipsis"/></Border>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Message}" Style="{DynamicResource Text.EmptyStateBody}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </Grid>
                <WrapPanel Grid.Row="1" Style="{DynamicResource Workspace.Toolbar}">
                    <ComboBox Text="{Binding StatusFilter, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Style="{DynamicResource ComboBox.Toolbar}" AutomationProperties.Name="Filtro de status de alerta" TabIndex="40"/>
                    <ComboBox Text="{Binding SeverityFilter, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Style="{DynamicResource ComboBox.Toolbar}" AutomationProperties.Name="Filtro de severidade de alerta" TabIndex="41"/>
                    <TextBlock Text="{Binding DataContext.AlertsInstruction, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource Text.EmptyStateBody}" VerticalAlignment="Center" Margin="0,0,8,8" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                    <Button Content="{Binding DataContext.RefreshLabel, RelativeSource={RelativeSource AncestorType=Window}}" Click="RefreshAlertsButton_OnClick" Style="{DynamicResource Button.Toolbar}" AutomationProperties.Name="Atualizar alertas" TabIndex="43"/>
                    <Button Content="{Binding DataContext.AcknowledgeLabel, RelativeSource={RelativeSource AncestorType=Window}}" Click="AcknowledgeAlertButton_OnClick" Style="{DynamicResource Button.Toolbar}" MinWidth="98" AutomationProperties.Name="Reconhecer alerta" TabIndex="44"/>
                    <Button Content="{Binding DataContext.ResolveLabel, RelativeSource={RelativeSource AncestorType=Window}}" Click="ResolveAlertButton_OnClick" Style="{DynamicResource Button.Toolbar}" AutomationProperties.Name="Resolver alerta" TabIndex="45"/>
                    <Button Content="{Binding DataContext.ReopenLabel, RelativeSource={RelativeSource AncestorType=Window}}" Click="ReopenAlertButton_OnClick" Style="{DynamicResource Button.Toolbar}" AutomationProperties.Name="Reabrir alerta" TabIndex="46"/>
                </WrapPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Alerts}" SelectedItem="{Binding SelectedAlert}" AutomationProperties.Name="Central de alertas" TabIndex="47">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnSeverity}" Binding="{Binding Severity}" Width="70"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnStatus}" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnRule}" Binding="{Binding RuleId}" Width="170"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnTarget}" Binding="{Binding Target}" Width="140"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnOccurrences}" Binding="{Binding Occurrences}" Width="70"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnLastSeen}" Binding="{Binding LastSeen}" Width="135"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnMessage}" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TabControl Grid.Row="3" Margin="0,8,0,0" AutomationProperties.Name="Detalhes do alerta">
                    <TabItem Header="{x:Static res:AppStrings.TabSummary}"><TextBox Text="{Binding SelectedSummary, Mode=OneWay}" Style="{DynamicResource TextBox.Details}"/></TabItem>
                    <TabItem Header="{x:Static res:AppStrings.TabEvidence}"><TextBox Text="{Binding SelectedEvidence, Mode=OneWay}" Style="{DynamicResource TextBox.Details}"/></TabItem>
                    <TabItem Header="{x:Static res:AppStrings.TabContext}"><TextBox Text="{Binding SelectedContext, Mode=OneWay}" Style="{DynamicResource TextBox.Details}"/></TabItem>
                    <TabItem Header="{x:Static res:AppStrings.TabTimeline}"><TextBox Text="{Binding SelectedTimeline, Mode=OneWay}" Style="{DynamicResource TextBox.Details}"/></TabItem>
                    <TabItem Header="{x:Static res:AppStrings.TabRule}"><TextBox Text="{Binding SelectedRule, Mode=OneWay}" Style="{DynamicResource TextBox.Details}"/></TabItem>
                </TabControl>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MetadataWorkspaceTemplate">
            <Grid DataContext="{Binding MetadataExplorer}" Style="{DynamicResource Workspace.Root}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="190"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:AppStrings.Metadata}" Style="{DynamicResource Text.EmptyStateTitle}"/>
                    <Border Grid.Row="0" Grid.Column="1" Style="{DynamicResource Badge.Neutral}" VerticalAlignment="Top"><TextBlock Style="{DynamicResource Text.Badge}" Text="{Binding SummaryText}" TextTrimming="CharacterEllipsis"/></Border>
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Message}" Style="{DynamicResource Text.EmptyStateBody}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </Grid>
                <WrapPanel Grid.Row="1" Style="{DynamicResource Workspace.Toolbar}">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TextBox.Toolbar}" MinWidth="260" AutomationProperties.Name="Busca de metadata" TabIndex="50"/>
                    <Button Content="{Binding DataContext.LoadLabel, RelativeSource={RelativeSource AncestorType=Window}}" Click="LoadMetadataCatalogButton_OnClick" Style="{DynamicResource Button.Toolbar}" AutomationProperties.Name="Carregar catálogo de metadata" TabIndex="51"/>
                    <Button Content="{Binding DataContext.RefreshLabel, RelativeSource={RelativeSource AncestorType=Window}}" Click="RefreshMetadataCatalogButton_OnClick" Style="{DynamicResource Button.Toolbar}" AutomationProperties.Name="Atualizar catálogo de metadata" TabIndex="52"/>
                    <Button Content="{Binding DataContext.ObjectLabel, RelativeSource={RelativeSource AncestorType=Window}}" Click="RefreshMetadataObjectButton_OnClick" Style="{DynamicResource Button.Toolbar}" AutomationProperties.Name="Atualizar objeto de metadata" TabIndex="53"/>
                    <Button Content="{Binding DataContext.BackLabel, RelativeSource={RelativeSource AncestorType=Window}}" Click="MetadataBackButton_OnClick" Style="{DynamicResource Button.Toolbar}" AutomationProperties.Name="Voltar metadata" TabIndex="54"/>
                    <Button Content="{Binding DataContext.ForwardLabel, RelativeSource={RelativeSource AncestorType=Window}}" Click="MetadataForwardButton_OnClick" Style="{DynamicResource Button.Toolbar}" AutomationProperties.Name="Avançar metadata" TabIndex="55"/>
                </WrapPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Objects}" SelectedItem="{Binding SelectedObject}" AutomationProperties.Name="Objetos de metadata" TabIndex="56">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnType}" Binding="{Binding Kind}" Width="120"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnName}" Binding="{Binding Name}" Width="220"/>
                        <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnDescription}" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TabControl Grid.Row="3" Margin="0,8,0,0" TabIndex="57">
                    <TabItem Header="{x:Static res:AppStrings.TabOverview}"><TextBox Text="{Binding SelectedOverview, Mode=OneWay}" Style="{DynamicResource TextBox.Details}"/></TabItem>
                    <TabItem Header="{x:Static res:AppStrings.TabColumns}"><TextBox Text="{Binding SelectedColumns, Mode=OneWay}" Style="{DynamicResource TextBox.Details}"/></TabItem>
                    <TabItem Header="{x:Static res:AppStrings.TabParameters}"><TextBox Text="{Binding SelectedParameters, Mode=OneWay}" Style="{DynamicResource TextBox.Details}"/></TabItem>
                    <TabItem Header="{x:Static res:AppStrings.TabIndexes}"><TextBox Text="{Binding SelectedIndexes, Mode=OneWay}" Style="{DynamicResource TextBox.Details}"/></TabItem>
                    <TabItem Header="{x:Static res:AppStrings.TabConstraints}"><TextBox Text="{Binding SelectedConstraints, Mode=OneWay}" Style="{DynamicResource TextBox.Details}"/></TabItem>
                    <TabItem Header="{x:Static res:AppStrings.TabTriggers}"><TextBox Text="{Binding SelectedTriggers, Mode=OneWay}" Style="{DynamicResource TextBox.Details}"/></TabItem>
                    <TabItem Header="{x:Static res:AppStrings.TabDependencies}"><TextBox Text="{Binding SelectedDependencies, Mode=OneWay}" Style="{DynamicResource TextBox.Details}"/></TabItem>
                    <TabItem Header="{x:Static res:AppStrings.TabSource}"><TextBox Text="{Binding SelectedSource, Mode=OneWay}" Style="{DynamicResource TextBox.Details}"/></TabItem>
                    <TabItem Header="{x:Static res:AppStrings.TabDdl}"><TextBox Text="{Binding SelectedDdl, Mode=OneWay}" Style="{DynamicResource TextBox.Details}"/></TabItem>
                    <TabItem Header="{x:Static res:AppStrings.TabError}"><TextBox Text="{Binding SelectedError, Mode=OneWay}" Style="{DynamicResource TextBox.Details}"/></TabItem>
                </TabControl>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SecurityWorkspaceTemplate">
            <Grid DataContext="{Binding SecurityWorkspace}" Style="{DynamicResource Workspace.Root}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="100"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:AppStrings.Security}" Style="{DynamicResource Text.EmptyStateTitle}"/>
                    <Border Grid.Row="0" Grid.Column="1" Style="{DynamicResource Badge.Neutral}" VerticalAlignment="Top"><TextBlock Style="{DynamicResource Text.Badge}" Text="{Binding SummaryText}" TextTrimming="CharacterEllipsis"/></Border>
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Message}" Style="{DynamicResource Text.EmptyStateBody}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </Grid>
                <WrapPanel Grid.Row="1" Style="{DynamicResource Workspace.Toolbar}">
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TextBox.Toolbar}" MinWidth="260" AutomationProperties.Name="Filtro de segurança" TabIndex="60"/>
                    <Button Content="{Binding DataContext.LoadLabel, RelativeSource={RelativeSource AncestorType=Window}}" Click="LoadSecurityButton_OnClick" Style="{DynamicResource Button.Toolbar}" AutomationProperties.Name="Carregar segurança" TabIndex="61"/>
                    <Button Content="{Binding DataContext.RefreshLabel, RelativeSource={RelativeSource AncestorType=Window}}" Click="RefreshSecurityButton_OnClick" Style="{DynamicResource Button.Toolbar}" AutomationProperties.Name="Atualizar segurança" TabIndex="62"/>
                    <Button Content="{Binding DataContext.MarkStaleLabel, RelativeSource={RelativeSource AncestorType=Window}}" Click="MarkSecurityStaleButton_OnClick" Style="{DynamicResource Button.Toolbar}" MinWidth="98" AutomationProperties.Name="Marcar cache de segurança stale" TabIndex="63"/>
                </WrapPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <DataGrid Grid.Column="0" ItemsSource="{Binding Principals}" SelectedItem="{Binding SelectedPrincipal}" Margin="0,0,8,0" AutomationProperties.Name="Usuários e roles" TabIndex="64">
                        <DataGrid.Columns><DataGridTextColumn Header="{x:Static res:AppStrings.ColumnType}" Binding="{Binding Type}" Width="70"/><DataGridTextColumn Header="{x:Static res:AppStrings.ColumnName}" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="{x:Static res:AppStrings.ColumnSource}" Binding="{Binding Source}" Width="90"/></DataGrid.Columns>
                    </DataGrid>
                    <DataGrid Grid.Column="1" ItemsSource="{Binding Grants}" SelectedItem="{Binding SelectedGrant}" AutomationProperties.Name="Grants de segurança" TabIndex="65">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnPrincipal}" Binding="{Binding Principal}" Width="150"/><DataGridTextColumn Header="{x:Static res:AppStrings.ColumnPrivilege}" Binding="{Binding Privilege}" Width="90"/><DataGridTextColumn Header="{x:Static res:AppStrings.ColumnObject}" Binding="{Binding Object}" Width="160"/>
                            <DataGridTextColumn Header="{x:Static res:AppStrings.ColumnField}" Binding="{Binding Field}" Width="90"/><DataGridTextColumn Header="{x:Static res:AppStrings.ColumnGrantor}" Binding="{Binding Grantor}" Width="100"/><DataGridTextColumn Header="{x:Static res:AppStrings.ColumnType}" Binding="{Binding Kind}" Width="120"/><DataGridTextColumn Header="{x:Static res:AppStrings.ColumnGrantOption}" Binding="{Binding GrantOption}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                <TextBox Grid.Row="3" Text="{Binding SelectedDetails, Mode=OneWay}" Style="{DynamicResource TextBox.Details}" Margin="0,8,0,0" AutomationProperties.Name="Detalhes de segurança"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MaintenanceWorkspaceTemplate">
            <Grid DataContext="{Binding MaintenanceWorkspace}" Style="{DynamicResource Workspace.Root}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="110"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:AppStrings.Maintenance}" Style="{DynamicResource Text.EmptyStateTitle}"/>
                    <Border Grid.Row="0" Grid.Column="1" Style="{DynamicResource Badge.Neutral}" VerticalAlignment="Top"><TextBlock Style="{DynamicResource Text.Badge}" Text="{Binding Stage}" TextTrimming="CharacterEllipsis"/></Border>
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Message}" Style="{DynamicResource Text.EmptyStateBody}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </Grid>
                <Border Grid.Row="1" Style="{DynamicResource Panel.Detail}" Margin="0,12,0,8" Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{DynamicResource Text.StatusBar}" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
                            <TextBlock Text="{Binding ProgressStatusText}" Style="{DynamicResource Text.EmptyStateBody}" TextWrapping="Wrap"/>
                        </DockPanel>
                        <ProgressBar Grid.Row="1"
                                     Height="18"
                                     Margin="0,8,0,0"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding ProgressValue}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                                     Foreground="{DynamicResource Brush.Accent}"
                                     Background="{DynamicResource Brush.Surface.Input}"
                                     BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                     AutomationProperties.Name="Progresso da manutenção"/>
                    </Grid>
                </Border>
                <WrapPanel Grid.Row="2" Style="{DynamicResource Workspace.Toolbar}">
                    <ComboBox Text="{Binding OperationType, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Style="{DynamicResource ComboBox.Toolbar}" AutomationProperties.Name="Tipo de operação de manutenção" TabIndex="70"><ComboBoxItem Content="{x:Static res:AppStrings.MaintenanceOperationBackup}"/><ComboBoxItem Content="{x:Static res:AppStrings.MaintenanceOperationRestore}"/><ComboBoxItem Content="{x:Static res:AppStrings.MaintenanceOperationValidation}"/><ComboBoxItem Content="{x:Static res:AppStrings.MaintenanceOperationSweep}"/></ComboBox>
                    <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TextBox.Toolbar}" MinWidth="220" AutomationProperties.Name="Caminho de origem da manutenção" TabIndex="71"/>
                    <TextBox Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TextBox.Toolbar}" MinWidth="220" AutomationProperties.Name="Caminho de destino da manutenção" TabIndex="72"/>
                    <CheckBox Content="{Binding DataContext.ConfirmLabel, RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding Confirmed}" Margin="0,0,8,8" AutomationProperties.Name="Confirmar operação de manutenção" TabIndex="73"/>
                    <Button Content="{Binding DataContext.ValidateLabel, RelativeSource={RelativeSource AncestorType=Window}}" Click="ValidateMaintenanceButton_OnClick" Style="{DynamicResource Button.Toolbar}" AutomationProperties.Name="Validar manutenção" TabIndex="74"/>
                    <Button Content="{Binding DataContext.ExecuteLabel, RelativeSource={RelativeSource AncestorType=Window}}" Click="ExecuteMaintenanceButton_OnClick" IsEnabled="{Binding CanExecute}" Style="{DynamicResource Button.Primary}" AutomationProperties.Name="Executar manutenção" TabIndex="75"/>
                    <Button Content="{Binding DataContext.CancelLabel, RelativeSource={RelativeSource AncestorType=Window}}" Click="CancelMaintenanceButton_OnClick" Style="{DynamicResource Button.Toolbar}" AutomationProperties.Name="Cancelar manutenção" TabIndex="76"/>
                </WrapPanel>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ToolsetText}" Style="{DynamicResource Text.StatusBar}" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="{Binding DataContext.UpdateHistoryLabel, RelativeSource={RelativeSource AncestorType=Window}}" Click="RefreshMaintenanceHistoryButton_OnClick" HorizontalAlignment="Right" MinWidth="126" AutomationProperties.Name="Atualizar histórico de manutenção"/>
                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding PreflightText, Mode=OneWay}" Style="{DynamicResource TextBox.Details}" Margin="0,8,8,0" AutomationProperties.Name="Resultado do preflight"/>
                    <ListBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Logs}" Margin="8,8,0,0" AutomationProperties.Name="Log de manutenção"/>
                </Grid>
                <Grid Grid.Row="4" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                    <DataGrid Grid.Column="0" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" AutomationProperties.Name="Histórico de manutenção" TabIndex="77">
                        <DataGrid.Columns><DataGridTextColumn Header="{x:Static res:AppStrings.ColumnType}" Binding="{Binding Type}" Width="90"/><DataGridTextColumn Header="{x:Static res:AppStrings.ColumnStatus}" Binding="{Binding Status}" Width="95"/><DataGridTextColumn Header="{x:Static res:AppStrings.ColumnStarted}" Binding="{Binding StartedAt}" Width="120"/><DataGridTextColumn Header="{x:Static res:AppStrings.ColumnMessage}" Binding="{Binding Message}" Width="*"/></DataGrid.Columns>
                    </DataGrid>
                    <TextBox Grid.Column="1" Text="{Binding SelectedHistoryDetails, Mode=OneWay}" Style="{DynamicResource TextBox.Details}" Margin="8,0,0,0" AutomationProperties.Name="Detalhes da manutenção"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SettingsWorkspaceTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Style="{DynamicResource Workspace.Root}" MaxWidth="760" HorizontalAlignment="Left">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding ConnectionProfilesTitle}" Style="{DynamicResource Text.EmptyStateTitle}"/>
                        <TextBlock Grid.Row="1" Text="{Binding WorkspacePlaceholder}" Style="{DynamicResource Text.EmptyStateBody}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding NameLabel}" Style="{DynamicResource Text.StatusBar}" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" AutomationProperties.Name="Nome do perfil" TabIndex="80"/>
                        <TextBlock Grid.Row="1" Text="{Binding HostLabel}" Style="{DynamicResource Text.StatusBar}" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" AutomationProperties.Name="Servidor Firebird" TabIndex="81"/>
                        <TextBlock Grid.Row="2" Text="{Binding PortLabel}" Style="{DynamicResource Text.StatusBar}" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" AutomationProperties.Name="Porta Firebird" TabIndex="82"/>
                        <TextBlock Grid.Row="3" Text="{Binding DatabaseLabel}" Style="{DynamicResource Text.StatusBar}" VerticalAlignment="Center"/>
                        <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Banco ou alias Firebird" TabIndex="83"/>
                            <Button Grid.Column="1" Content="{Binding SelectDatabaseLabel}" Click="SelectDatabaseButton_OnClick" Style="{DynamicResource Button.Toolbar}" MinWidth="104" Margin="8,0,0,0" AutomationProperties.Name="Selecionar arquivo de banco Firebird" TabIndex="84"/>
                        </Grid>
                        <TextBlock Grid.Row="4" Text="{Binding UserNameLabel}" Style="{DynamicResource Text.StatusBar}" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" AutomationProperties.Name="Usuário Firebird" TabIndex="85"/>
                        <TextBlock Grid.Row="5" Text="{Binding PasswordLabel}" Style="{DynamicResource Text.StatusBar}" VerticalAlignment="Center"/><PasswordBox Grid.Row="5" Grid.Column="1" Loaded="PasswordInput_OnLoaded" Unloaded="PasswordInput_OnUnloaded" Margin="0,0,0,10" AutomationProperties.Name="Senha Firebird" TabIndex="86"/>
                        <TextBlock Grid.Row="6" Text="{Binding RoleLabel}" Style="{DynamicResource Text.StatusBar}" VerticalAlignment="Center"/><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Role, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" AutomationProperties.Name="Role Firebird" TabIndex="87"/>
                        <CheckBox Grid.Row="7" Grid.Column="1" Content="{Binding RememberPasswordLabel}" IsChecked="{Binding RememberPassword}" Margin="0,2,0,14" AutomationProperties.Name="Lembrar senha" TabIndex="88"/>
                        <WrapPanel Grid.Row="8" Grid.Column="1">
                            <Button Content="{Binding SaveProfileLabel}" Click="SaveProfileButton_OnClick" Style="{DynamicResource Button.Toolbar}" MinWidth="110" AutomationProperties.Name="Salvar perfil de conexão" TabIndex="89"/>
                            <Button Content="{Binding TestConnectionLabel}" Click="TestConnectionButton_OnClick" Style="{DynamicResource Button.Toolbar}" MinWidth="130" AutomationProperties.Name="Testar conexão Firebird" TabIndex="90"/>
                            <Button Content="{Binding ConnectLabel}" Click="ConnectButton_OnClick" Style="{DynamicResource Button.Primary}" MinWidth="100" IsDefault="True" AutomationProperties.Name="Conectar ao Firebird" TabIndex="91"/>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="{DynamicResource Size.StatusBar.Height}"/></Grid.RowDefinitions>
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Surface.Raised}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown"
                AutomationProperties.Name="Barra de título do Firebird Admin">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="pack://application:,,,/FirebirdAdmin.Presentation.Wpf;component/Assets/Branding/FirebirdAdmin_Icon_1024.png"
                           Width="18"
                           Height="18"
                           Stretch="Uniform"
                           Margin="0,0,8,0"
                           AutomationProperties.Name="Ícone Firebird Admin"/>
                    <TextBlock Text="{Binding ApplicationName}" Style="{DynamicResource Text.StatusBar}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="&#xE921;"
                            Click="MinimizeWindowButton_OnClick"
                            Style="{DynamicResource Button.WindowChrome}"
                            ToolTip="Minimizar"
                            AutomationProperties.Name="Minimizar janela"/>
                    <Button Click="MaximizeRestoreWindowButton_OnClick"
                            Style="{DynamicResource Button.WindowChrome}"
                            ToolTip="Maximizar ou restaurar"
                            AutomationProperties.Name="Maximizar ou restaurar janela">
                        <TextBlock x:Name="MaximizeRestoreGlyph" Text="&#xE923;" FontFamily="Segoe MDL2 Assets"/>
                    </Button>
                    <Button Content="&#xE8BB;"
                            Click="CloseWindowButton_OnClick"
                            Style="{DynamicResource Button.WindowClose}"
                            ToolTip="Fechar"
                            AutomationProperties.Name="Fechar janela"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource Size.Navigation.ExpandedWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface.Navigation}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,1,0" Padding="{DynamicResource Spacing.Thickness.L}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding NavigationTitle}" Style="{DynamicResource Text.NavigationTitle}"/>
                    <Button DockPanel.Dock="Bottom"
                            Click="ExitButton_OnClick"
                            Style="{DynamicResource Button.Toolbar}"
                            Margin="0,12,0,0"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="Sair do Firebird Admin">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="&#xE8BB;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource Brush.Text.Subtle}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ExitLabel}"
                                       Style="{DynamicResource Text.NavigationItem}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <ListBox ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}" Style="{DynamicResource ListBox.Navigation}" Margin="0,16,0,0" AutomationProperties.Name="Navegação principal">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding IconGlyph}"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="{DynamicResource Brush.Text.Subtle}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                    <AccessText Grid.Column="1" Text="{Binding AccessText}" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="{DynamicResource Size.ConnectionContext.Height}"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.Raised}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="16,10">
                    <DockPanel LastChildFill="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/FirebirdAdmin.Presentation.Wpf;component/Assets/Branding/FirebirdAdmin_Icon_1024.png"
                                   Width="34"
                                   Height="34"
                                   Margin="0,0,10,0"
                                   Stretch="Uniform"
                                   AutomationProperties.Name="Firebird Admin"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ApplicationName}" Style="{DynamicResource Text.AppTitle}"/>
                                <TextBlock Text="{Binding WorkspaceTitle}" Style="{DynamicResource Text.StatusBar}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding AboutLabel}" Command="{Binding ShowAboutCommand}" Style="{DynamicResource Button.Toolbar}" MinWidth="76" Margin="0,0,8,0" AutomationProperties.Name="Abrir informações sobre o Firebird Admin"/>
                            <Button Content="{Binding ThemeToggleLabel}" Command="{Binding ToggleThemeCommand}" Style="{DynamicResource Button.Toolbar}" MinWidth="104" Margin="0,0,8,0" AutomationProperties.Name="Alternar tema"/>
                            <Border Style="{DynamicResource Badge.Neutral}" MaxWidth="620"><TextBlock Text="{Binding ConnectionContext}" Style="{DynamicResource Text.Badge}" TextTrimming="CharacterEllipsis"/></Border>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Background="{DynamicResource Brush.Surface.Workspace}" Style="{DynamicResource Card.Workspace}">
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource DashboardWorkspaceTemplate}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedWorkspace}" Value="{x:Static shell:ShellWorkspace.Dashboard}"><Setter Property="ContentTemplate" Value="{StaticResource DashboardWorkspaceTemplate}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedWorkspace}" Value="{x:Static shell:ShellWorkspace.Monitoring}"><Setter Property="ContentTemplate" Value="{StaticResource MonitoringWorkspaceTemplate}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedWorkspace}" Value="{x:Static shell:ShellWorkspace.SqlProfiler}"><Setter Property="ContentTemplate" Value="{StaticResource ProfilerWorkspaceTemplate}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedWorkspace}" Value="{x:Static shell:ShellWorkspace.Diagnostics}"><Setter Property="ContentTemplate" Value="{StaticResource AlertsWorkspaceTemplate}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedWorkspace}" Value="{x:Static shell:ShellWorkspace.Metadata}"><Setter Property="ContentTemplate" Value="{StaticResource MetadataWorkspaceTemplate}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedWorkspace}" Value="{x:Static shell:ShellWorkspace.Security}"><Setter Property="ContentTemplate" Value="{StaticResource SecurityWorkspaceTemplate}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedWorkspace}" Value="{x:Static shell:ShellWorkspace.Maintenance}"><Setter Property="ContentTemplate" Value="{StaticResource MaintenanceWorkspaceTemplate}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedWorkspace}" Value="{x:Static shell:ShellWorkspace.History}"><Setter Property="ContentTemplate" Value="{StaticResource HistoryWorkspaceTemplate}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedWorkspace}" Value="{x:Static shell:ShellWorkspace.Settings}"><Setter Property="ContentTemplate" Value="{StaticResource SettingsWorkspaceTemplate}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.StatusBar}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0" Padding="{DynamicResource Spacing.StatusBar.Padding}">
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <TextBlock Text="{Binding ReadyStatus}" Style="{DynamicResource Text.StatusBar}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding TraceStatus}" Style="{DynamicResource Text.StatusBar}" Margin="24,0,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding PollingStatus}" Style="{DynamicResource Text.StatusBar}" Margin="24,0,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding KeyboardHelp}" Style="{DynamicResource Text.StatusBar}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <Grid Grid.RowSpan="3"
              Panel.ZIndex="20"
              Background="{DynamicResource Brush.Surface.Workspace}"
              Visibility="{Binding IsAboutOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{DynamicResource Panel.Detail}"
                    Width="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24"
                    AutomationProperties.Name="{Binding AboutTitle}">
                <StackPanel>
                    <Image Source="pack://application:,,,/FirebirdAdmin.Presentation.Wpf;component/Assets/Branding/FirebirdAdmin_Logo.png"
                           Height="104"
                           Stretch="Uniform"
                           Margin="0,0,0,20"
                           AutomationProperties.Name="Logo Firebird Admin"/>
                    <TextBlock Text="{Binding AboutTitle}" Style="{DynamicResource Text.EmptyStateTitle}" TextAlignment="Center"/>
                    <TextBlock Text="{Binding AboutVersionText}" Style="{DynamicResource Text.StatusBar}" TextAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding AboutDescription}" Style="{DynamicResource Text.EmptyStateBody}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,20"/>
                    <Button Content="{Binding AboutCloseLabel}" Command="{Binding CloseAboutCommand}" Style="{DynamicResource Button.Primary}" MinWidth="96" HorizontalAlignment="Center" IsCancel="True" AutomationProperties.Name="Fechar sobre o Firebird Admin"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
