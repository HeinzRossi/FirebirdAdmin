<Window x:Class="FirebirdAdmin.Presentation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="{Binding ApplicationName}"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="620"
        Background="{DynamicResource Brush.App.Background}"
        Foreground="{DynamicResource Brush.App.Foreground}"
        FontFamily="{DynamicResource FontFamily.Base}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="{DynamicResource Size.StatusBar.Height}"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource Size.Navigation.ExpandedWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.Surface.Navigation}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="0,0,1,0"
                    Padding="{DynamicResource Spacing.Thickness.L}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding NavigationTitle}"
                               Style="{DynamicResource Text.NavigationTitle}"/>
                    <ItemsControl ItemsSource="{Binding NavigationItems}" Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource Card.NavigationItem}">
                                    <TextBlock Text="{Binding Title}" Style="{DynamicResource Text.NavigationItem}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{DynamicResource Size.ConnectionContext.Height}"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource Brush.Surface.Raised}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        BorderThickness="0,0,0,1"
                        Padding="{DynamicResource Spacing.Thickness.L}">
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="{Binding ApplicationName}" Style="{DynamicResource Text.AppTitle}"/>
                        <Border DockPanel.Dock="Right" Style="{DynamicResource Badge.Neutral}">
                            <TextBlock Text="{Binding ConnectionContext}" Style="{DynamicResource Text.Badge}"/>
                        </Border>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1" Margin="{DynamicResource Spacing.Thickness.XL}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding WorkspaceTitle}"
                               Style="{DynamicResource Text.PageTitle}"/>

                    <Border Grid.Row="1" Margin="0,16,0,0" Style="{DynamicResource Card.Workspace}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="420"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding ConnectionProfilesTitle}" Style="{DynamicResource Text.EmptyStateTitle}"/>
                                <TextBlock Text="{Binding WorkspacePlaceholder}" Style="{DynamicResource Text.EmptyStateBody}" Margin="0,8,0,16" TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding NameLabel}" Style="{DynamicResource Text.StatusBar}"/>
                                <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                                <TextBlock Text="{Binding HostLabel}" Style="{DynamicResource Text.StatusBar}"/>
                                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                                <TextBlock Text="{Binding PortLabel}" Style="{DynamicResource Text.StatusBar}"/>
                                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                                <TextBlock Text="{Binding DatabaseLabel}" Style="{DynamicResource Text.StatusBar}"/>
                                <TextBox Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                                <TextBlock Text="{Binding UserNameLabel}" Style="{DynamicResource Text.StatusBar}"/>
                                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                                <TextBlock Text="{Binding PasswordLabel}" Style="{DynamicResource Text.StatusBar}"/>
                                <PasswordBox x:Name="PasswordInput" Margin="0,4,0,10"/>

                                <TextBlock Text="{Binding RoleLabel}" Style="{DynamicResource Text.StatusBar}"/>
                                <TextBox Text="{Binding Role, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                                <CheckBox Content="{Binding RememberPasswordLabel}"
                                          IsChecked="{Binding RememberPassword}"
                                          Margin="0,2,0,14"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding SaveProfileLabel}" Click="SaveProfileButton_OnClick" MinWidth="110"/>
                                    <Button Content="{Binding TestConnectionLabel}" Click="TestConnectionButton_OnClick" MinWidth="130" Margin="8,0,0,0"/>
                                    <Button Content="{Binding ConnectLabel}" Click="ConnectButton_OnClick" MinWidth="100" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Column="1"
                                  Margin="32,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="260"/>
                                    <RowDefinition Height="220"/>
                                    <RowDefinition Height="240"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0"
                                      DataContext="{Binding Dashboard}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="150"/>
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0">
                                        <StackPanel>
                                            <TextBlock Text="Dashboard operacional" Style="{DynamicResource Text.EmptyStateTitle}"/>
                                            <TextBlock Text="{Binding HealthMessage}" Style="{DynamicResource Text.EmptyStateBody}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Border Style="{DynamicResource Badge.Neutral}" Margin="0,0,8,0">
                                                <TextBlock Style="{DynamicResource Text.Badge}" Text="{Binding HealthText}"/>
                                            </Border>
                                            <Border Style="{DynamicResource Badge.Neutral}">
                                                <TextBlock Style="{DynamicResource Text.Badge}" Text="{Binding LastUpdatedText, StringFormat=Atualizado: {0}}"/>
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>

                                    <ItemsControl Grid.Row="1"
                                                  ItemsSource="{Binding Metrics}"
                                                  Margin="0,14,0,10">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="5"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Brush.App.Background}"
                                                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource Radius.M}"
                                                        Padding="12,10"
                                                        Margin="0,0,8,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" Style="{DynamicResource Text.StatusBar}"/>
                                                        <TextBlock Text="{Binding Value}" Style="{DynamicResource Text.NavigationItem}" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding Detail}" Style="{DynamicResource Text.EmptyStateBody}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <scott:WpfPlot x:Name="ActivityPlot"
                                                   Grid.Row="2"
                                                   Height="140"/>
                                </Grid>

                                <Grid Grid.Row="1"
                                      Margin="0,18,0,0"
                                      DataContext="{Binding TransactionsWorkspace}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="140"/>
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0">
                                    <StackPanel>
                                        <TextBlock Text="Monitoramento - Transações" Style="{DynamicResource Text.EmptyStateTitle}"/>
                                        <TextBlock Text="{Binding Message}" Style="{DynamicResource Text.EmptyStateBody}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Border Style="{DynamicResource Badge.Neutral}" Margin="0,0,8,0">
                                            <TextBlock Style="{DynamicResource Text.Badge}" Text="{Binding TransactionCount, StringFormat=Transações: {0}}"/>
                                        </Border>
                                        <Border Style="{DynamicResource Badge.Neutral}">
                                            <TextBlock Style="{DynamicResource Text.Badge}" Text="{Binding ActiveTransactionCount, StringFormat=Ativas: {0}}"/>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>

                                <Grid Grid.Row="1" Margin="0,16,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Filtro SQL/ID" Style="{DynamicResource Text.StatusBar}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <DataGrid Grid.Row="2"
                                          ItemsSource="{Binding Transactions}"
                                          SelectedItem="{Binding SelectedTransaction}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Transaction" Binding="{Binding TransactionId}" Width="100"/>
                                        <DataGridTextColumn Header="Attachment" Binding="{Binding AttachmentId}" Width="100"/>
                                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80"/>
                                        <DataGridTextColumn Header="Started" Binding="{Binding StartedAt}" Width="160"/>
                                        <DataGridTextColumn Header="OIT" Binding="{Binding OldestTransaction}" Width="90"/>
                                        <DataGridTextColumn Header="OAT" Binding="{Binding OldestActive}" Width="90"/>
                                        <DataGridTextColumn Header="Isolation" Binding="{Binding IsolationMode}" Width="90"/>
                                        <DataGridTextColumn Header="Lock Timeout" Binding="{Binding LockTimeout}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Row="3"
                                        Margin="0,12,0,0"
                                        Background="{DynamicResource Brush.App.Background}"
                                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.L}"
                                        Padding="{DynamicResource Spacing.Thickness.L}">
                                    <StackPanel>
                                        <TextBlock Text="Detalhes da transação" Style="{DynamicResource Text.NavigationItem}"/>
                                        <TextBlock Text="{Binding SelectedTransaction.TransactionId, StringFormat=ID: {0}}" Style="{DynamicResource Text.EmptyStateBody}" Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding SelectedTransaction.AttachmentId, StringFormat=Attachment: {0}}" Style="{DynamicResource Text.EmptyStateBody}"/>
                                        <TextBlock Text="{Binding SelectedTransaction.StartedAt, StringFormat=Início: {0}}" Style="{DynamicResource Text.EmptyStateBody}"/>
                                    </StackPanel>
                                </Border>
                                </Grid>

                                <Grid Grid.Row="2"
                                      Margin="0,18,0,0"
                                      DataContext="{Binding ProfilerWorkspace}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="88"/>
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0">
                                        <StackPanel>
                                            <TextBlock Text="SQL Profiler" Style="{DynamicResource Text.EmptyStateTitle}"/>
                                            <TextBlock Text="{Binding Message}" Style="{DynamicResource Text.EmptyStateBody}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Border Style="{DynamicResource Badge.Neutral}" Margin="0,0,8,0">
                                                <TextBlock Style="{DynamicResource Text.Badge}" Text="{Binding StateText}"/>
                                            </Border>
                                            <Border Style="{DynamicResource Badge.Neutral}">
                                                <TextBlock Style="{DynamicResource Text.Badge}" Text="{Binding BufferedCount, StringFormat=Buffer: {0}}"/>
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>

                                    <Grid Grid.Row="1" Margin="0,12,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Iniciar" Click="StartProfilerButton_OnClick" MinWidth="78"/>
                                        <Button Grid.Column="1" Content="Pausar visual" Click="PauseProfilerButton_OnClick" MinWidth="108" Margin="8,0,0,0"/>
                                        <Button Grid.Column="2" Content="Follow" Click="FollowProfilerButton_OnClick" MinWidth="78" Margin="8,0,0,0"/>
                                        <Button Grid.Column="3" Content="Encerrar" Click="StopProfilerButton_OnClick" MinWidth="84" Margin="8,0,0,0"/>
                                        <Button Grid.Column="4" Content="Limpar" Click="ClearProfilerButton_OnClick" MinWidth="78" Margin="8,0,0,0"/>
                                        <TextBox Grid.Column="5" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Margin="12,0,0,0"/>
                                    </Grid>

                                    <DataGrid Grid.Row="2"
                                              ItemsSource="{Binding Events}"
                                              SelectedItem="{Binding SelectedEvent}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              EnableRowVirtualization="True"
                                              EnableColumnVirtualization="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="64"/>
                                            <DataGridTextColumn Header="Hora" Binding="{Binding Timestamp}" Width="95"/>
                                            <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="120"/>
                                            <DataGridTextColumn Header="ms" Binding="{Binding Duration}" Width="70"/>
                                            <DataGridTextColumn Header="Usuário" Binding="{Binding UserName}" Width="90"/>
                                            <DataGridTextColumn Header="Att" Binding="{Binding AttachmentId}" Width="70"/>
                                            <DataGridTextColumn Header="Tra" Binding="{Binding TransactionId}" Width="70"/>
                                            <DataGridTextColumn Header="SQL / Trace" Binding="{Binding SqlPreview}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TabControl Grid.Row="3" Margin="0,8,0,0">
                                        <TabItem Header="SQL">
                                            <TextBox Text="{Binding SelectedSql, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/>
                                        </TabItem>
                                        <TabItem Header="Performance">
                                            <TextBox Text="{Binding SelectedPerformance, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/>
                                        </TabItem>
                                        <TabItem Header="Contexto">
                                            <TextBox Text="{Binding SelectedContext, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/>
                                        </TabItem>
                                        <TabItem Header="Plano">
                                            <TextBox Text="{Binding SelectedPlan, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/>
                                        </TabItem>
                                        <TabItem Header="Trace">
                                            <TextBox Text="{Binding SelectedRawTrace, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/>
                                        </TabItem>
                                    </TabControl>
                                </Grid>

                                <Grid Grid.Row="3"
                                      Margin="0,18,0,0"
                                      DataContext="{Binding HistoryWorkspace}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="62"/>
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0">
                                        <StackPanel>
                                            <TextBlock Text="Histórico" Style="{DynamicResource Text.EmptyStateTitle}"/>
                                            <TextBlock Text="{Binding Message}" Style="{DynamicResource Text.EmptyStateBody}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <Border DockPanel.Dock="Right" Style="{DynamicResource Badge.Neutral}">
                                            <TextBlock Style="{DynamicResource Text.Badge}" Text="{Binding TotalCount, StringFormat=Total: {0}}"/>
                                        </Border>
                                    </DockPanel>

                                    <Grid Grid.Row="1" Margin="0,10,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" Text="{Binding DataKind, UpdateSourceTrigger=PropertyChanged}" IsEditable="True">
                                            <ComboBoxItem Content="Trace"/>
                                            <ComboBoxItem Content="Monitoring"/>
                                        </ComboBox>
                                        <TextBox Grid.Column="1" Text="{Binding SqlText, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0"/>
                                        <TextBox Grid.Column="2" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0"/>
                                        <Button Grid.Column="3" Content="Pesquisar" Click="SearchHistoryButton_OnClick" MinWidth="96" Margin="8,0,0,0"/>
                                        <Button Grid.Column="4" Content="CSV" Click="ExportHistoryCsvButton_OnClick" MinWidth="58" Margin="8,0,0,0"/>
                                        <Button Grid.Column="5" Content="JSON" Click="ExportHistoryJsonButton_OnClick" MinWidth="62" Margin="8,0,0,0"/>
                                        <TextBlock Grid.Column="6" Text="{Binding Page, StringFormat=Pg {0}}" Style="{DynamicResource Text.StatusBar}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>

                                    <DataGrid Grid.Row="2"
                                              ItemsSource="{Binding Rows}"
                                              SelectedItem="{Binding SelectedRow}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              EnableRowVirtualization="True"
                                              EnableColumnVirtualization="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="56"/>
                                            <DataGridTextColumn Header="Hora" Binding="{Binding Timestamp}" Width="135"/>
                                            <DataGridTextColumn Header="Origem" Binding="{Binding Kind}" Width="82"/>
                                            <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="110"/>
                                            <DataGridTextColumn Header="Usuário" Binding="{Binding UserName}" Width="90"/>
                                            <DataGridTextColumn Header="ms" Binding="{Binding Duration}" Width="70"/>
                                            <DataGridTextColumn Header="Resumo" Binding="{Binding Summary}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBox Grid.Row="3"
                                             Text="{Binding SelectedDetails, Mode=OneWay}"
                                             Margin="0,8,0,0"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             BorderThickness="0"/>
                                </Grid>

                                <Grid Grid.Row="4"
                                      Margin="0,18,0,0"
                                      DataContext="{Binding AlertsCenter}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="90"/>
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0">
                                        <StackPanel>
                                            <TextBlock Text="Diagnóstico / Alertas" Style="{DynamicResource Text.EmptyStateTitle}"/>
                                            <TextBlock Text="{Binding Message}" Style="{DynamicResource Text.EmptyStateBody}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Border Style="{DynamicResource Badge.Neutral}" Margin="0,0,8,0">
                                                <TextBlock Style="{DynamicResource Text.Badge}" Text="{Binding ActiveCount, StringFormat=Ativos: {0}}"/>
                                            </Border>
                                            <Border Style="{DynamicResource Badge.Neutral}">
                                                <TextBlock Style="{DynamicResource Text.Badge}" Text="{Binding CriticalCount, StringFormat=Críticos: {0}}"/>
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>

                                    <Grid Grid.Row="1" Margin="0,10,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding StatusFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="1" Text="{Binding SeverityFilter, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0"/>
                                        <Button Grid.Column="2" Content="Atualizar" Click="RefreshAlertsButton_OnClick" MinWidth="86" Margin="8,0,0,0"/>
                                        <Button Grid.Column="3" Content="Reconhecer" Click="AcknowledgeAlertButton_OnClick" MinWidth="96" Margin="8,0,0,0"/>
                                        <Button Grid.Column="4" Content="Resolver" Click="ResolveAlertButton_OnClick" MinWidth="82" Margin="8,0,0,0"/>
                                        <Button Grid.Column="5" Content="Reabrir" Click="ReopenAlertButton_OnClick" MinWidth="76" Margin="8,0,0,0"/>
                                    </Grid>

                                    <DataGrid Grid.Row="2"
                                              ItemsSource="{Binding Alerts}"
                                              SelectedItem="{Binding SelectedAlert}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              EnableRowVirtualization="True"
                                              EnableColumnVirtualization="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Sev" Binding="{Binding Severity}" Width="70"/>
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                            <DataGridTextColumn Header="Regra" Binding="{Binding RuleId}" Width="170"/>
                                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="140"/>
                                            <DataGridTextColumn Header="Ocorr." Binding="{Binding Occurrences}" Width="70"/>
                                            <DataGridTextColumn Header="Último" Binding="{Binding LastSeen}" Width="135"/>
                                            <DataGridTextColumn Header="Mensagem" Binding="{Binding Message}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TabControl Grid.Row="3" Margin="0,8,0,0">
                                        <TabItem Header="Resumo">
                                            <TextBox Text="{Binding SelectedSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/>
                                        </TabItem>
                                        <TabItem Header="Evidências">
                                            <TextBox Text="{Binding SelectedEvidence, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/>
                                        </TabItem>
                                        <TabItem Header="Contexto">
                                            <TextBox Text="{Binding SelectedContext, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/>
                                        </TabItem>
                                        <TabItem Header="Timeline">
                                            <TextBox Text="{Binding SelectedTimeline, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/>
                                        </TabItem>
                                        <TabItem Header="Regra">
                                            <TextBox Text="{Binding SelectedRule, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Surface.StatusBar}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="{DynamicResource Spacing.StatusBar.Padding}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ReadyStatus}" Style="{DynamicResource Text.StatusBar}"/>
                <TextBlock Text="{Binding TraceStatus}" Style="{DynamicResource Text.StatusBar}" Margin="24,0,0,0"/>
                <TextBlock Text="{Binding PollingStatus}" Style="{DynamicResource Text.StatusBar}" Margin="24,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
