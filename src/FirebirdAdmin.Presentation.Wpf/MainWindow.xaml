<Window x:Class="FirebirdAdmin.Presentation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding ApplicationName}"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="620"
        Background="{DynamicResource Brush.App.Background}"
        Foreground="{DynamicResource Brush.App.Foreground}"
        FontFamily="{DynamicResource FontFamily.Base}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="{DynamicResource Size.StatusBar.Height}"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource Size.Navigation.ExpandedWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.Surface.Navigation}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="0,0,1,0"
                    Padding="{DynamicResource Spacing.Thickness.L}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding NavigationTitle}"
                               Style="{DynamicResource Text.NavigationTitle}"/>
                    <ItemsControl ItemsSource="{Binding NavigationItems}" Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource Card.NavigationItem}">
                                    <TextBlock Text="{Binding Title}" Style="{DynamicResource Text.NavigationItem}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{DynamicResource Size.ConnectionContext.Height}"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource Brush.Surface.Raised}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        BorderThickness="0,0,0,1"
                        Padding="{DynamicResource Spacing.Thickness.L}">
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="{Binding ApplicationName}" Style="{DynamicResource Text.AppTitle}"/>
                        <Border DockPanel.Dock="Right" Style="{DynamicResource Badge.Neutral}">
                            <TextBlock Text="{Binding ConnectionContext}" Style="{DynamicResource Text.Badge}"/>
                        </Border>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1" Margin="{DynamicResource Spacing.Thickness.XL}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding WorkspaceTitle}"
                               Style="{DynamicResource Text.PageTitle}"/>

                    <Border Grid.Row="1"
                            Margin="0,16,0,0"
                            Style="{DynamicResource Card.Workspace}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ReadyStatus}"
                                       Style="{DynamicResource Text.EmptyStateTitle}"
                                       TextAlignment="Center"/>
                            <TextBlock Text="{Binding WorkspacePlaceholder}"
                                       Style="{DynamicResource Text.EmptyStateBody}"
                                       TextAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Surface.StatusBar}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="{DynamicResource Spacing.StatusBar.Padding}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ReadyStatus}" Style="{DynamicResource Text.StatusBar}"/>
                <TextBlock Text="{Binding TraceStatus}" Style="{DynamicResource Text.StatusBar}" Margin="24,0,0,0"/>
                <TextBlock Text="{Binding PollingStatus}" Style="{DynamicResource Text.StatusBar}" Margin="24,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
