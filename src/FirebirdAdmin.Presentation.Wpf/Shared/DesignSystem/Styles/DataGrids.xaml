<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Workspace}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.App.Foreground}"/>
        <Setter Property="RowBackground" Value="{DynamicResource Brush.Surface.Workspace}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush.Surface.Panel}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="RowHeight" Value="28"/>
        <Setter Property="ColumnHeaderHeight" Value="30"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle">
            <Setter.Value>
                <Style TargetType="Control">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <Rectangle Stroke="{DynamicResource Brush.Focus}" StrokeThickness="2" RadiusX="4" RadiusY="4" Margin="-3"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Brush.Grid.Header}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Subtle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Grid.RowHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Grid.RowSelected}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.App.Foreground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
